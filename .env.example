# Copy to .env for Docker Compose or .env.local for local development. Never commit secrets.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
MONGODB_URI=
MONGODB_DB=pom
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Register http://localhost:3000/api/todoist/callback as the redirect URL.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Generate with: openssl rand -hex 32 (encrypts per-user Todoist tokens at rest)
TOKEN_ENCRYPTION_KEY=
